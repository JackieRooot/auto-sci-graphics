# ==========================================
# 1. 操作系统生成的垃圾文件 (Mac/Windows/Linux)
# ==========================================
.DS_Store        # Mac 系统的隐藏目录文件
Thumbs.db        # Windows 系统的缩略图缓存
Desktop.ini      # Windows 系统的文件夹配置

# ==========================================
# 2. IDE / 编辑器 配置文件
# ==========================================
.vscode/         # VS Code 的项目配置
.idea/           # JetBrains (PyCharm/IntelliJ) 配置
*.swp            # Vim 产生的临时文件
*.swo            # Vim 产生的临时文件
*~               # 其他编辑器备份文件

# ==========================================
# 3. Python 专属
# ==========================================
__pycache__/     # Python 运行时的字节码缓存目录
*.py[cod]        # 编译后的文件 (.pyc, .pyo, .pyd)
*$py.class       # Java 虚拟机上的 Python 缓存

# 虚拟环境 (极其重要！千万不要把虚拟环境传上去)
env/
venv/
ENV/
env.bak/
venv.bak/

# 分发 / 打包
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 单元测试 / 覆盖率
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ==========================================
# 4. Jupyter Notebook (如果你用 Jupyter 写代码)
# ==========================================
.ipynb_checkpoints  # Jupyter 自动保存的检查点

# ==========================================
# 5. 环境变量与敏感信息 (⚠️极其重要⚠️)
# ==========================================
.env              # 常用的存放 API Key、数据库密码的文件
*.local           # 本地配置文件
secrets.yaml      # 敏感配置
credentials.json  # 凭证文件 (比如 Google API 的凭证)

# ==========================================
# 6. 数据与模型文件 (科研/绘图常见)
# ==========================================
# 如果你的数据集太大，或者模型文件太大，建议忽略它们
# 取消下面几行的注释来忽略大文件
# *.csv
# *.xlsx
# *.json  # 注意：如果你用 json 存配置不要忽略，如果只存数据可以忽略
# *.h5
# *.hdf5
# *.pkl
# *.pth
# *.onnx
# data/          # 忽略整个 data 文件夹
# models/        # 忽略整个 models 文件夹

# ==========================================
# 7. 日志文件
# ==========================================
*.log
logs/

# ==========================================
# 8. 特定文件
# ==========================================
test-e.py
test.py
学习记录.txt